#!/usr/bin/env bash
# The one git entry. Sandbox commits only. The caller's GIT_* is dropped.
set -u
while IFS= read -r name; do
  unset "$name"
done < <(env | sed -n 's/=.*//p' | grep '^GIT_' || true)
export GIT_CONFIG_GLOBAL=/dev/null
export GIT_CONFIG_NOSYSTEM=1
export GIT_OPTIONAL_LOCKS=0
cfg=(
  -c core.hooksPath=/dev/null
  -c user.name=hex0-gate
  -c user.email=hex0-gate@example.invalid
  -c commit.gpgsign=false
  -c core.fsmonitor=false
  -c maintenance.auto=false
)
extra=()
while [ $# -gt 0 ]; do
  case $1 in
    -c)
      extra+=(-c "$2")
      shift 2
      ;;
    -C)
      extra+=(-C "$2")
      shift 2
      ;;
    *)
      break
      ;;
  esac
done
if [ $# -lt 1 ]; then
  echo "verify: git-sandbox: missing subcommand" >&2
  exit 2
fi
sub=$1
shift
readonly=0
case $sub in
  diff|status|ls-files|ls-tree|check-attr|rev-parse|bundle|cat-file|hash-object|merge-base)
    readonly=1
    ;;
esac
if [ "$readonly" -eq 1 ]; then
  gd=$(git "${cfg[@]}" "${extra[@]}" rev-parse --absolute-git-dir 2>/dev/null || true)
  if [ -n "$gd" ] && [ -f "$gd/index" ]; then
    copy=$(mktemp "${TMPDIR:-/var/tmp}/hex0-index.XXXXXX")
    cp "$gd/index" "$copy"
    export GIT_INDEX_FILE=$copy
  fi
fi
case $sub in
  clone)
    exec git "${cfg[@]}" "${extra[@]}" clone --template= --no-local "$@"
    ;;
  commit)
    exec git "${cfg[@]}" "${extra[@]}" commit --no-verify "$@"
    ;;
  *)
    exec git "${cfg[@]}" "${extra[@]}" "$sub" "$@"
    ;;
esac
