#!/bin/bash
# Sequencer until M0's brief. The gate checks. It does not call this file.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
mkdir -p "$root/out"
"$root/ladder/0-hex0/x86_64-linux/hex0" \
  "$root/ladder/1-hex1/x86_64-linux/hex1.hex0" \
  "$root/out/hex1"
"$root/out/hex1" \
  "$root/ladder/1-hex1/x86_64-linux/hex1.hex1" \
  "$root/out/hex1-self"
"$root/out/hex1" \
  "$root/ladder/2-hex2/x86_64-linux/hex2.hex1" \
  "$root/out/hex2"
"$root/out/hex2" \
  "$root/ladder/2-hex2/x86_64-linux/hex2.hex2" \
  "$root/out/hex2-self"
"$root/out/hex2" \
  "$root/ladder/3-m0/x86_64-linux/m0.hex2" \
  "$root/out/m0"
"$root/out/m0" \
  "$root/ladder/3-m0/x86_64-linux/m0.m0" \
  "$root/out/m0.hex2"
"$root/out/hex2" \
  "$root/out/m0.hex2" \
  "$root/out/m0-self"
"$root/out/m0" \
  "$root/ladder/4-wat0/x86_64-linux/wat0.m0" \
  "$root/out/wat0.hex2"
"$root/out/hex2" \
  "$root/out/wat0.hex2" \
  "$root/out/wat0"
"$root/out/hex2" \
  "$root/ladder/4-wat0/x86_64-linux/wat0.hex2" \
  "$root/out/wat0-self"
