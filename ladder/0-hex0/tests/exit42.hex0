# probe-exit42.hex0 -- the smallest honest program: exit(42).
# The input language is the one in ladder/0-hex0/README.md.
# One ELF64 header, one PT_LOAD program header, twelve bytes of code. Loaded at 0x400000.

## ELF header (64 bytes)
7F 45 4C 46            # magic: 0x7F 'E' 'L' 'F'
02 01 01 00            # 64-bit, little-endian, ELF version 1, System V ABI
00 00 00 00 00 00 00 00  # ABI version + padding
02 00                  # e_type: ET_EXEC
3E 00                  # e_machine: x86-64
01 00 00 00            # e_version
78 00 40 00 00 00 00 00  # e_entry: 0x400078 (code starts right after the two headers)
40 00 00 00 00 00 00 00  # e_phoff: 64
00 00 00 00 00 00 00 00  # e_shoff: no section headers
00 00 00 00            # e_flags
40 00                  # e_ehsize: 64
38 00                  # e_phentsize: 56
01 00                  # e_phnum: 1
00 00 00 00 00 00      # e_shentsize, e_shnum, e_shstrndx: none

## Program header (56 bytes): load the whole file, read+execute
01 00 00 00            # p_type: PT_LOAD
05 00 00 00            # p_flags: R + X
00 00 00 00 00 00 00 00  # p_offset: 0
00 00 40 00 00 00 00 00  # p_vaddr: 0x400000
00 00 40 00 00 00 00 00  # p_paddr
84 00 00 00 00 00 00 00  # p_filesz: 132
84 00 00 00 00 00 00 00  # p_memsz: 132
00 10 00 00 00 00 00 00  # p_align: 4096

## Code (12 bytes) at 0x400078
B8 3C 00 00 00         # mov eax, 60   ; sys_exit
BF 2A 00 00 00         # mov edi, 42   ; status
0F 05                  # syscall
