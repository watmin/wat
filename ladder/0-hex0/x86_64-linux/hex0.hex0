# hex0 -- turn commented hex into bytes. Rung 0 of the ladder.
# Invocation: hex0 IN OUT
# Platform: x86-64 Linux. Syscalls only. No libc.
#
# One per target: that target's seed, written as commented hex so every byte
# can be audited by hand. This target is x86_64-linux. Its source is
# ladder/0-hex0/x86_64-linux/hex0.hex0 and its seed is
# ladder/0-hex0/x86_64-linux/hex0. The input language and the refusals are
# in the rung README (ladder/0-hex0/README.md). This file does not restate
# them. A stranger checks the bytes by stripping comments and packing the
# hex with sed and xxd, then comparing. hex-check.py is a second reader.
# Running this seed on its own source proves self-consistency, not trust.
# Disassemble the code with:
#   objdump -D -b binary -m i386:x86-64 --start-address=0x78 hex0
#
# Instruction comments are AT&T syntax, in file offsets only. Each begins
# with the file offset of that instruction. Jump targets in those comments
# are file offsets too. objdump is given --adjust-vma so its addresses are
# file offsets (the code begins at file offset 0x78, virtual 0x400078).
# The bad-byte push, die (pop into edi), and exit (syscall 60) are the
# three ways out of the loop. Success jumps to exit with edi = 0.
# p_filesz is the sum 0x78 + 417 = 537.
#
# syscall returns in rax and clobbers rcx and r11. Every other register
# survives a syscall. rcx is not held across one.
#
# Registers, and the file offset that sets each value:
#   r12   fd of IN, set at +009d (mov %eax,%r12d) after open IN
#   r13   fd of OUT, set at +00bf (mov %eax,%r13d) after open OUT
#   r14b  1 when a high nibble is waiting, else 0. Cleared at +0159 and +01c8
#   r15b  that high nibble, set at +01b5 (mov %al,%r15b)
#   r10b  1 while skipping a comment, set at +01dc, cleared at +015c and +01ec
#   rbp   st_dev of IN, set at +00df (mov (%rsp),%rbp) from offset 0 of the stat buffer
#   r8    st_ino of IN, set at +00e3 (mov 0x8(%rsp),%r8) from offset 8
#   rsi   four values, in order:
#           the stat buffer, set at +00c9 (mov %rsp,%rsi), reused by fstat OUT
#           0x1ED, set at +012c (mov $0x1ed,%esi) for fchmod
#           0, set at +0144 (xor %esi,%esi) for ftruncate
#           the one-byte buffer, set at +0153 (mov %rsp,%rsi) for read and write
#   rdx   0x1ED at +00aa (mov $0x1ed,%edx) for open OUT, then 1 at +0158 (pop %rdx)
#   rcx   clobbered by syscall
#   [rsp] the one-byte buffer, inside the 144-byte stack slot
# The slot is 144 bytes because that is the x86-64 ABI's struct stat.
# fstat is passed rsp. st_dev is offset 0, st_ino is offset 8, st_mode is offset 24.
# Syscalls: read 0, write 1, open 2, close 3, fstat 5, exit 60,
#   ftruncate 77, fchmod 91.
# Open OUT with O_WRONLY|O_CREAT|O_NONBLOCK (0x841), no O_TRUNC, mode 0755 (0x1ED).
# Then fstat both descriptors. Then, if OUT is a regular file,
# fchmod(OUT, 0755) and ftruncate(OUT, 0).

# ## ELF header (64 bytes)
7F 45 4C 46             # magic: 7F 'E' 'L' 'F'
02 01 01 00             # 64-bit, little-endian, ELF version 1, System V ABI
00 00 00 00 00 00 00 00 # ABI version + padding
02 00                   # e_type: ET_EXEC
3E 00                   # e_machine: x86-64
01 00 00 00             # e_version
78 00 40 00 00 00 00 00 # e_entry: 0x400078, the first instruction
40 00 00 00 00 00 00 00 # e_phoff: 64
00 00 00 00 00 00 00 00 # e_shoff: no section headers
00 00 00 00             # e_flags
40 00                   # e_ehsize: 64
38 00                   # e_phentsize: 56
01 00                   # e_phnum: 1
00 00 00 00 00 00       # e_shentsize, e_shnum, e_shstrndx: none

# ## Program header (56 bytes): load the whole file, read and execute
01 00 00 00             # p_type: PT_LOAD
05 00 00 00             # p_flags: PF_R + PF_X
00 00 00 00 00 00 00 00 # p_offset: 0
00 00 40 00 00 00 00 00 # p_vaddr: 0x400000
00 00 40 00 00 00 00 00 # p_paddr
19 02 00 00 00 00 00 00 # p_filesz: 0x78 + 417 = 537
19 02 00 00 00 00 00 00 # p_memsz: 0x78 + 417 = 537
00 10 00 00 00 00 00 00 # p_align: 4096

